#!/bin/sh
set -e

COMMAND="${1:-}"
APP_CONTAINER="api-products"

##########################################

case "$COMMAND" in
  up)
    docker compose up -d
    ;;
  up-kibana)
    docker compose --profile kibana up -d
    ;;
  down)
    docker compose --profile kibana down
    ;;
  prune)
    docker compose --profile kibana down --rmi local --volumes --remove-orphans
    ;;
  prune-all)
    docker compose --profile kibana down --rmi all --volumes --remove-orphans
    ;;
  bash)
    shift
    if [ "$#" -eq 0 ]; then
      docker exec -it "$APP_CONTAINER" bash
    else
      docker exec -it "$APP_CONTAINER" bash -c "$*"
    fi
    ;;
  test)
    shift
    docker exec -it "$APP_CONTAINER" php artisan test --parallel "$@"
    ;;
  pint)
    shift
    docker exec -it "$APP_CONTAINER" ./vendor/bin/pint "$@"
    ;;
  artisan)
    shift
    docker exec -it "$APP_CONTAINER" php artisan "$@"
    ;;
  create-envs)
    shift
    ./scripts/create_envs.sh "$@"
    ;;
  *)
    echo "Docker Scripts"
    echo "Uso:"
    echo " $0 up                 → sobe todos os containers, exceto o Kibana (docker compose up -d)"
    echo " $0 up-kibana          → sobe todos os containers incluindo o Kibana (profile kibana)"
    echo " $0 down               → derruba todos os containers"
    echo " $0 prune              → derruba containers + volumes + imagem local do projeto (preserva imagens de registry como postgres/redis)"
    echo " $0 prune-all          → derruba containers + volumes + TODAS as imagens, inclusive as de registry (postgres/redis/nginx/elasticsearch/kibana)"
    echo " $0 bash [cmd]         → terminal do container app; com args, executa o comando (ex.: $0 bash ls -la)"
    echo " $0 test [args]        → roda os testes em paralelo (php artisan test --parallel)"
    echo " $0 pint [args]        → roda o Pint (formata o codigo)"
    echo " $0 artisan <cmd>      → roda um comando artisan (ex.: $0 artisan migrate)"
    echo " $0 create-envs [uid] [gid] → cria o .env a partir do .env.example e define UID/GID"
    exit 1
    ;;
esac
