              "path": ["api", "v1", "products", "{{product_id}}"]
            },
            "description": "Atualiza o produto de {{product_id}}. Aceita atualizacao parcial (todos os campos sao nullable)."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Modo Bearer: remove Referer/Origin para nao acionar o modo stateful do Sanctum (que exigiria CSRF mesmo com Bearer valido).",
                  "if (pm.collectionVariables.get('api_token')) {",
                  "  pm.request.headers.remove('Referer');",
                  "  pm.request.headers.remove('Origin');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Delete Product",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Referer", "value": "{{base_url}}" },
              { "key": "Origin", "value": "{{base_url}}" },
              { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/products/{{product_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "products", "{{product_id}}"]
            },
            "description": "Remove o produto de {{product_id}}. Retorna 204 No Content."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Modo Bearer: remove Referer/Origin para nao acionar o modo stateful do Sanctum (que exigiria CSRF mesmo com Bearer valido).",
                  "if (pm.collectionVariables.get('api_token')) {",
                  "  pm.request.headers.remove('Referer');",
                  "  pm.request.headers.remove('Origin');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
