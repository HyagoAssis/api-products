    {
      "name": "5. Login",
      "request": {
        "auth": { "type": "noauth" },
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Referer", "value": "{{base_url}}" },
          { "key": "Origin", "value": "{{base_url}}" },
          { "key": "X-XSRF-TOKEN", "value": "{{xsrf_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/login",
        "description": "Loga com o usuario do seed ({{user_email}} / {{user_password}}). Rode 'CSRF Cookie' antes se a sessao expirou."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Create Token",
      "request": {
        "auth": {
          "type": "basic",
          "basic": [
            { "key": "username", "value": "{{user_email}}", "type": "string" },
            { "key": "password", "value": "{{user_password}}", "type": "string" }
          ]
        },
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token_name\": \"meu-app\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": "{{base_url}}/api/token/create",
        "description": "Emite um token Bearer via HTTP Basic. O Postman monta o header Authorization: Basic base64({{user_email}}:{{user_password}}) automaticamente a partir do auth Basic desta request. Rota publica: NAO precisa de sessao/CSRF, basta um usuario ja registrado (rode '2. Register'). O Test salva o token em {{api_token}}, que passa a ser usado no Authorization Bearer de todas as requests."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "if (json && json.token) {",
              "  pm.collectionVariables.set('api_token', json.token);",
              "  pm.environment.set('api_token', json.token);",
              "  console.log('Bearer token salvo em {{api_token}}:', json.token);",
              "} else {",
              "  console.warn('Resposta sem \"token\". Confira se o usuario foi registrado (rode 2. Register) e as credenciais em {{user_email}}/{{user_password}}. Resposta:', JSON.stringify(json));",
              "}"
            ]
          }
        }
      ]
    },
